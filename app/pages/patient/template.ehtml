import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { SiteHeader } from "#app/shared/templates/site-header";
import { recallState } from "#app/shared/services/patients";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Empty } from "@elements/ui/empty";
import { Table, TableCell, TableHead } from "@elements/ui/table";
import {
  AppointmentStatus,
  AppointmentType,
  PRACTICE,
  STATUS_LABELS,
  formatCalendarDate,
  formatShortDate,
  formatTime,
  visitType,
} from "#app/shared/practice";

export interface PatientRecord {
  id: string;
  firstName: string;
  lastName: string;
  email: string;
  phone: string;
  birthDate: string | null;
  recallDate: string | null;
  recallNoticeSentAt: Date | null;
  createdAt: Date;
}

export interface PatientVisit {
  id: string;
  type: AppointmentType;
  status: AppointmentStatus;
  startsAt: Date;
  doctorName: string;
  intakeDone: boolean;
}

const STATUS_TONES: Record<AppointmentStatus, "accent" | "info" | "success" | "danger"> = {
  booked: "accent",
  checkedIn: "info",
  completed: "success",
  cancelled: "danger",
};

function upcoming(visits: PatientVisit[]): PatientVisit[] {
  return visits
    .filter((v) => v.status !== "completed" && v.status !== "cancelled" && v.startsAt.getTime() > Date.now() - 3_600_000)
    .sort((a, b) => +a.startsAt - +b.startsAt);
}

function past(visits: PatientVisit[]): PatientVisit[] {
  return visits.filter((v) => !upcoming(visits).includes(v));
}

function age(birthDate: string, today: string): number {
  let years = Number(today.slice(0, 4)) - Number(birthDate.slice(0, 4));

  return today.slice(5) < birthDate.slice(5) ? years - 1 : years;
}

<html lang="en" class="page-patient" (patient: PatientRecord, visits: PatientVisit[], today: string)>
  <head>
    <title>{patient.firstName} {patient.lastName} · {PRACTICE.name}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <div class="app">
      <SiteHeader area="desk" current="patients" />

      <main class="app-main">
        <div class="page-shell is-wide patient-main stack is-lg">
          <a href="/desk/patients">← Patients</a>

          <div class="row record-head">
            <div class="stack is-xs">
              <h1>{patient.firstName} {patient.lastName}</h1>
              <p class="hint">Patient since {formatShortDate(patient.createdAt)}</p>
            </div>
            <Button variant="primary" href={`/book?type=exam&email=${encodeURIComponent(patient.email)}`}>Book a visit</Button>
          </div>

          <div class="record-grid">
            <div class="stack">
              <Card title="Contact" level={2}>
                <CardContent>
                  <dl>
                    <dt>Email</dt>
                    <dd><a href={`mailto:${patient.email}`}>{patient.email}</a></dd>
                    <dt>Phone</dt>
                    <dd><a href={`tel:${patient.phone}`}>{patient.phone || "Not given"}</a></dd>
                    <dt>Date of birth</dt>
                    <dd>{patient.birthDate ? `${formatCalendarDate(patient.birthDate)} (${age(patient.birthDate, today)})` : "Not given"}</dd>
                  </dl>
                </CardContent>
              </Card>

              <Card title="Next recall" level={2}>
                <CardContent class="stack is-sm">
                  <div class="cluster is-sm">
                    <span class="recall-date">{patient.recallDate ? formatCalendarDate(patient.recallDate) : "Not set"}</span>
                    <Badge e:if={recallState(patient.recallDate, today) === "overdue"} variant="danger">Overdue</Badge>
                    <Badge e:if={recallState(patient.recallDate, today) === "due"} variant="warning">Due soon</Badge>
                  </div>
                  <p class="hint" e:if={patient.recallNoticeSentAt}>Recall email sent {formatShortDate(patient.recallNoticeSentAt!)}.</p>
                  <p class="hint" e:else>Set a year after each completed exam.</p>
                </CardContent>
              </Card>
            </div>

            <div class="stack">
              <Card title="Upcoming" level={2}>
                <CardContent e:if={upcoming(visits).length === 0}>
                  <Empty description="Nothing booked." />
                </CardContent>
                <Table e:else label="Upcoming visits">
                  <table>
                    <tbody>
                      <tr e:for={v of upcoming(visits)}>
                        <TableCell>{formatShortDate(v.startsAt)}, {formatTime(v.startsAt)}</TableCell>
                        <TableCell>{visitType(v.type).label}</TableCell>
                        <TableCell>{v.doctorName}</TableCell>
                        <TableCell>
                          <div class="cluster is-xs">
                            <Badge variant={STATUS_TONES[v.status]}>{STATUS_LABELS[v.status]}</Badge>
                            <Badge e:if={v.intakeDone} variant="success">Intake in</Badge>
                            <Badge e:else variant="warning">No intake</Badge>
                          </div>
                        </TableCell>
                      </tr>
                    </tbody>
                  </table>
                </Table>
              </Card>

              <Card title="Past visits" level={2}>
                <CardContent e:if={past(visits).length === 0}>
                  <Empty description="No past visits." />
                </CardContent>
                <Table e:else label="Past visits">
                  <table>
                    <thead>
                      <tr><TableHead>Date</TableHead><TableHead>Visit</TableHead><TableHead>Doctor</TableHead><TableHead>Status</TableHead></tr>
                    </thead>
                    <tbody>
                      <tr e:for={v of past(visits)} class={[v.status === "cancelled" && "is-cancelled"]}>
                        <TableCell>{formatShortDate(v.startsAt)}</TableCell>
                        <TableCell>{visitType(v.type).label}</TableCell>
                        <TableCell>{v.doctorName}</TableCell>
                        <TableCell><Badge variant={STATUS_TONES[v.status]}>{STATUS_LABELS[v.status]}</Badge></TableCell>
                      </tr>
                    </tbody>
                  </table>
                </Table>
              </Card>
            </div>
          </div>
        </div>
      </main>
    </div>
  </body>
</html>
