import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { SiteHeader } from "#app/shared/templates/site-header";
import { PRACTICE, formatCalendarDate, formatShortDate } from "#app/shared/practice";
import { PatientRow, recallState } from "#app/shared/services/patients";
import { searchPatients } from "./services";
import { DataTable, DataTableColumn } from "@elements/ui/data-table";
import { Empty } from "@elements/ui/empty";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@elements/ui/tabs";

interface PatientsUi {
  query: string;
  filter: "all" | "recall";
  rows: PatientRow[];
}

const RECALL_LABELS = {
  overdue: { label: "Overdue", tint: "danger" },
  due: { label: "Due soon", tint: "warning" },
  later: { label: "", tint: "" },
  none: { label: "", tint: "" },
} as const;

function columns(today: string): DataTableColumn[] {
  return [
    {
      id: "patient",
      header: "Patient",
      rowHeader: true,
      value: (p) => `${p.lastName}, ${p.firstName}`,
      cell: (p, name) => ({ text: String(name), href: `/desk/patients/${p.id}` }),
    },
    {
      id: "contact",
      header: "Contact",
      value: (p) => p.email,
      cell: (p) => ({ text: p.email, description: p.phone }),
    },
    {
      id: "lastVisit",
      header: "Last visit",
      value: (p) => p.lastVisit,
      cell: (p) => p.lastVisit ? formatShortDate(p.lastVisit) : "None",
    },
    {
      id: "nextVisit",
      header: "Next visit",
      value: (p) => p.nextVisit,
      cell: (p) => p.nextVisit ? formatShortDate(p.nextVisit) : "None booked",
    },
    {
      id: "recall",
      header: "Recall",
      value: (p) => p.recallDate,
      cell: (p) => ({
        text: p.recallDate ? formatCalendarDate(p.recallDate) : "Not set",
        description: RECALL_LABELS[recallState(p.recallDate, today)].label,
      }),
      background: (_, p) => RECALL_LABELS[recallState(p.recallDate, today)].tint,
    },
  ];
}

function onSearch(ui: PatientsUi) {
  ui.rows = searchPatients(ui.query, ui.filter);
}

function onQuery(ui: PatientsUi, query: string) {
  ui.query = query;
  onSearch(ui);
}

function onFilter(ui: PatientsUi, filter: "all" | "recall") {
  ui.filter = filter;
  onSearch(ui);
  history.replaceState(null, "", filter === "recall" ? "/desk/patients?filter=recall" : "/desk/patients");
}

<html lang="en" class="page-patients" (
  initial: PatientRow[],
  filter: "all" | "recall",
  today: string,
  private ui: PatientsUi = { query: "", filter, rows: initial },
)>
  <head>
    <title>Patients · {PRACTICE.name}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <div class="app">
      <SiteHeader area="desk" current="patients" />

      <main class="app-main">
        <div class="page-shell is-wide patients-main stack is-lg">
          <h1>Patients</h1>

          <Tabs value={ui.filter} onValueChange={(value) => onFilter(ui, value === "recall" ? "recall" : "all")}>
            <TabsList label="Patients">
              <TabsTrigger value="all">All patients</TabsTrigger>
              <TabsTrigger value="recall">Recall due</TabsTrigger>
            </TabsList>
            <TabsContent value={ui.filter} class="patients-panel">
              <DataTable data={ui.rows}
                         columns={columns(today)}
                         label="Patients"
                         search={ui.query}
                         searchMode="none"
                         searchPlaceholder="Search name, email or phone"
                         onSearchChange={(query) => onQuery(ui, query)}
                         pagination={false}
                         sortable={false}
                         filterable={false}
                         exportable={false}
                         columnMenu={false}
                         resizable={false}
                         reorderable={false}
                         pinnable={false}
                         hideable={false}
                         groupable={false}
                         footer={false}>
                <Empty slot="empty" description="No patients match." />
              </DataTable>
            </TabsContent>
          </Tabs>
        </div>
      </main>
    </div>
  </body>
</html>
