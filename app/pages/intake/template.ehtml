import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { redirect, ValidationError } from "@elements/app";
import { SiteHeader } from "#app/shared/templates/site-header";
import { PRACTICE, VisitSummary, formatDateTime, visitType } from "#app/shared/practice";
import { Eyewear, IntakeForm, saveIntake } from "./services";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Textarea } from "@elements/ui/textarea";

interface IntakeUi {
  errors: Record<string, string[]>;
  error: string;
  busy: boolean;
}

const EYEWEAR: { id: Eyewear; label: string }[] = [
  { id: "glasses", label: "Glasses" },
  { id: "contacts", label: "Contact lenses" },
  { id: "both", label: "Both" },
  { id: "none", label: "Neither" },
];

/** A field's server error, until the patient fills the field in. */
function fieldError(ui: IntakeUi, form: IntakeForm, key: keyof IntakeForm): string {
  return form[key].trim() ? "" : ui.errors[key]?.[0] ?? "";
}

function onSubmit(visit: VisitSummary, form: IntakeForm, ui: IntakeUi) {
  ui.busy = true;
  ui.error = "";

  try {
    saveIntake(visit.token, form);
    ui.errors = {};
    redirect(`/visit/${visit.token}?intake=1`);
  } catch (err: any) {
    ui.busy = false;

    if (err instanceof ValidationError && err.errors && Object.keys(err.errors).length > 0) {
      ui.errors = err.errors as Record<string, string[]>;
      return;
    }

    ui.error = err.message;
  }
}

<html lang="en" class="page-intake" (
  visit: VisitSummary,
  initial: IntakeForm,
  submitted: boolean,
  private form: IntakeForm = initial,
  private ui: IntakeUi = { errors: {}, error: "", busy: false },
)>
  <head>
    <title>Intake form · {PRACTICE.name}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <div class="app">
      <SiteHeader area="patient" />

      <main class="app-main">
        <div class="page-shell is-form intake-main stack is-xl">
          <div class="stack is-sm">
            <a href={`/visit/${visit.token}`}>← Your visit</a>
            <h1>Before your visit</h1>
            <p class="lede">
              {visitType(visit.type).label} with {visit.doctorName},
              {formatDateTime(visit.startsAt)}.
            </p>
          </div>

          <form class="stack is-lg" onsubmit={() => onSubmit(visit, form, ui)}>
            <fieldset>
              <legend>Insurance</legend>
              <div class="pair">
                <Field label="Vision plan" error={fieldError(ui, form, "insuranceProvider")}>
                  <Input value={form.insuranceProvider} placeholder="Plan name, or self-pay"
                         attrs={{ id: "insuranceProvider" }} />
                </Field>
                <Field label="Member ID" description="On the front of your card.">
                  <Input value={form.insuranceMemberId} attrs={{ id: "insuranceMemberId", autocomplete: "off" }} />
                </Field>
              </div>
            </fieldset>

            <fieldset>
              <legend>What you wear now</legend>
              <div class="cluster eyewear-options" role="radiogroup">
                <label e:for={o of EYEWEAR} key={o.id}>
                  <input type="radio" name="eyewear" checked={form.eyewear === o.id} onchange={() => form.eyewear = o.id}>
                  {o.label}
                </label>
              </div>
              <Field e:if={form.eyewear !== "none"} label="Tell us about them">
                <Input value={form.eyewearNotes} placeholder="Brand, age, anything that bothers you"
                       attrs={{ id: "eyewearNotes" }} />
              </Field>
            </fieldset>

            <fieldset>
              <legend>Your health</legend>
              <Field label="Symptoms or concerns" error={fieldError(ui, form, "symptoms")}>
                <Textarea value={form.symptoms}
                          placeholder="Blurry vision, headaches, dry or itchy eyes, floaters…"
                          attrs={{ id: "symptoms" }} />
              </Field>
              <Field label="Current medications" error={fieldError(ui, form, "medications")}>
                <Textarea value={form.medications}
                          placeholder="Include eye drops and supplements"
                          attrs={{ id: "medications" }} />
              </Field>
            </fieldset>

            <Alert e:if={ui.error} variant="danger" description={ui.error} />

            <div class="row actions">
              <Button variant="ghost" href={`/visit/${visit.token}`}>Back</Button>
              <Button type="submit" variant="primary" size="lg" loading={ui.busy}>
                {submitted ? "Save changes" : "Send intake form"}
              </Button>
            </div>
          </form>
        </div>
      </main>
    </div>
  </body>
</html>
