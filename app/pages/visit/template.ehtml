import "./style.css";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { SiteHeader } from "#app/shared/templates/site-header";
import { SlotPicker, PickerState, refreshPicker } from "#app/shared/templates/slot-picker";
import { cancelVisit, rescheduleVisit } from "./services";
import { Alert, AlertDescription, AlertTitle } from "@elements/ui/alert";
import { AlertDialog, AlertDialogAction, AlertDialogCancel, AlertDialogFooter } from "@elements/ui/alert-dialog";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent, CardFooter } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { NativeSelect } from "@elements/ui/native-select";
import {
  Doctor,
  PRACTICE,
  STATUS_LABELS,
  VisitSummary,
  formatDateTime,
  formatTime,
  visitType,
} from "#app/shared/practice";

interface VisitUi {
  mode: "view" | "reschedule";
  error: string;
  notice: string;
}

function newUi(): VisitUi {
  return { mode: "view", error: "", notice: "" };
}

function isChangeable(visit: VisitSummary): boolean {
  return visit.status === "booked" && visit.startsAt.getTime() > Date.now();
}

function onStartReschedule(ui: VisitUi, picker: PickerState) {
  ui.mode = "reschedule";
  ui.error = "";
  refreshPicker(picker);
}

function onReschedule(state: { visit: VisitSummary }, ui: VisitUi, picker: PickerState) {
  if (!picker.startsAt) {
    return;
  }

  try {
    state.visit = rescheduleVisit(state.visit.token, picker.startsAt, picker.doctorId);
    ui.mode = "view";
    ui.error = "";
    ui.notice = `Moved to ${formatDateTime(state.visit.startsAt)}. We've emailed you the new details.`;
  } catch (err: any) {
    ui.error = err.message;
    refreshPicker(picker);
  }
}

function onCancel(state: { visit: VisitSummary }, ui: VisitUi) {
  ui.error = "";

  try {
    state.visit = cancelVisit(state.visit.token);
    ui.mode = "view";
    ui.notice = "";
  } catch (err: any) {
    ui.error = err.message;
  }
}

<html lang="en" class="page-visit" (
  initialVisit: VisitSummary,
  doctors: Doctor[],
  justBooked: boolean,
  intakeSent: boolean,
  pickerDate: string,
  private state: { visit: VisitSummary } = { visit: initialVisit },
  private ui: VisitUi = newUi(),
  private picker: PickerState = {
    type: initialVisit.type,
    doctorId: initialVisit.doctorId,
    date: pickerDate,
    slots: [],
    startsAt: null,
  },
)>
  <head>
    <title>Your visit · {PRACTICE.name}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <div class="app">
      <SiteHeader area="patient" />

      <main class="app-main">
        <div class="page-shell is-form visit-main stack is-xl">
          <Alert e:if={justBooked && state.visit.status === "booked" && !ui.notice}
                 variant="success"
                 role="none"
                 title={`You're booked, ${state.visit.firstName}.`}
                 description={`A confirmation is on its way to ${state.visit.email}.`} />

          <Alert e:if={intakeSent && state.visit.status === "booked" && !ui.notice}
                 variant="success"
                 role="status"
                 title={`Thanks, ${state.visit.firstName}. We have your intake form.`}
                 description="Your doctor will read it before your visit." />

          <Alert e:if={ui.notice} variant="success" role="status" description={ui.notice} />

          <Alert e:if={state.visit.status === "cancelled"} variant="warning" role="none">
            <AlertTitle>This visit is cancelled.</AlertTitle>
            <AlertDescription><a href={`/book?type=${state.visit.type}&email=${encodeURIComponent(state.visit.email)}`}>Book a new time</a> whenever you're ready.</AlertDescription>
          </Alert>

          <div class="stack is-sm">
            <p class="eyebrow">{visitType(state.visit.type).label}</p>
            <p class="visit-when">{formatDateTime(state.visit.startsAt)}</p>
            <p class="visit-meta">
              {state.visit.doctorName} · {visitType(state.visit.type).minutes} minutes<br>
              {PRACTICE.name}, {PRACTICE.address}
            </p>
            <div class="cluster is-sm">
              <Badge variant={state.visit.status === "cancelled" ? "danger" : "accent"}>{STATUS_LABELS[state.visit.status]}</Badge>
            </div>
          </div>

          <Card e:if={state.visit.status !== "cancelled"}>
            <CardContent class="row task">
              <div class="stack is-xs">
                <h2>Intake form</h2>
                <p e:if={state.visit.intakeDone}>Received. You can update it any time before your visit.</p>
                <p e:else>Insurance, current eyewear, symptoms and medications. About three minutes.</p>
              </div>
              <Button e:if={state.visit.intakeDone} href={`/visit/${state.visit.token}/intake`}>Review answers</Button>
              <Button e:else variant="primary" href={`/visit/${state.visit.token}/intake`}>Fill in intake</Button>
            </CardContent>
          </Card>

          <Card e:if={isChangeable(state.visit)}>
            <CardContent e:if={ui.mode === "view"} class="row task">
              <div class="stack is-xs">
                <h2>Need a different time?</h2>
                <p>Change or cancel online up to the start of your visit.</p>
              </div>
              <div class="cluster is-sm">
                <AlertDialog title="Cancel this visit?" description="Your time will be released for someone else.">
                  <Button slot="trigger" variant="ghost">Cancel visit</Button>
                  <AlertDialogFooter>
                    <AlertDialogCancel>Keep visit</AlertDialogCancel>
                    <AlertDialogAction variant="danger" onclick={() => onCancel(state, ui)}>Cancel visit</AlertDialogAction>
                  </AlertDialogFooter>
                </AlertDialog>
                <Button onclick={() => onStartReschedule(ui, picker)}>Reschedule</Button>
              </div>
            </CardContent>
            <CardContent e:if={ui.mode === "view" && ui.error}>
              <Alert variant="danger" description={ui.error} />
            </CardContent>

            <CardContent e:if={ui.mode === "reschedule"} class="stack">
              <h2>Pick a new time</h2>
              <Field label="Doctor" class="doctor-select">
                <NativeSelect value={picker.doctorId} block attrs={{ id: "doctor" }} onchange={() => refreshPicker(picker)}>
                  <option value="">First available</option>
                  <option e:for={d of doctors} value={d.id}>{d.name}</option>
                </NativeSelect>
              </Field>
              <SlotPicker {picker} />
              <Alert e:if={ui.error} variant="danger" description={ui.error} />
            </CardContent>
            <CardFooter e:if={ui.mode === "reschedule"}>
              <Button variant="ghost" onclick={() => { ui.mode = "view"; ui.error = ""; }}>Keep current time</Button>
              <Button variant="primary"
                      disabled={!picker.startsAt}
                      onclick={() => onReschedule(state, ui, picker)}>
                {picker.startsAt ? `Move to ${formatTime(picker.startsAt)}` : "Choose a time"}
              </Button>
            </CardFooter>
          </Card>

          <p class="hint">Questions? Call us at {PRACTICE.phone}.</p>
        </div>
      </main>
    </div>
  </body>
</html>
